# CodeGuardian AI — configuration. Everything here is OPTIONAL.
# Copy to `.env` (`cp .env.example .env`) and fill in only what you need.
# With nothing set, the pipeline runs in deterministic-only mode.
#
# NOTE: this is a TEMPLATE — keep all values blank here. Put real secrets in
# `.env` only (it is git-ignored). Never paste tokens into this file.

# --- GitHub (only needed for the live webhook / posting real comments) ---
# A secret STRING you invent, pasted identically into GitHub's webhook "Secret"
# field. Leave blank for local testing (dev mode skips signature checks).
# This is NOT your smee.io URL — the smee URL is the payload/proxy URL.
GITHUB_WEBHOOK_SECRET=
# Personal access token with repo scope; without it the webhook is dry-run.
GITHUB_TOKEN=

# --- LLM triage (optional, free with Groq) ---
# Get a free key at https://console.groq.com
LLM_API_KEY=
# OpenAI-compatible endpoint. Groq default shown; use http://localhost:11434/v1
# for Ollama, or https://api.openai.com/v1 for OpenAI.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model name — check your provider's current model list.
LLM_MODEL=llama-3.1-8b-instant

# --- RAG (Quality Agent context retrieval) ---
# On by default. Set to 1 to skip retrieval entirely (findings still ship;
# LLM explanations just lose the codebase/standards grounding).
RAG_DISABLE=

# --- Dashboard history database ---
# SQLite file recording every review for the dashboard charts. Relative paths
# resolve against the project root. Default: data/history.db
CODEGUARDIAN_DB=
